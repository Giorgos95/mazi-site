# Headers Cloudflare sends with the matching files. Pages themselves keep
# Cloudflare's default, so a push shows up for every visitor at once.

/*
  X-Content-Type-Options: nosniff

# Images keep their names when they change, so a browser holds them for a day
# and then fetches the new one in the background for up to a week.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# A font file never changes under its name (a new version gets a new name), so
# a browser keeps it for a year. "!" drops the /assets/* value above first.
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The icons browsers ask for at the root by name, cached like the images.
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The file iOS reads to let invite links open the app (Universal Links). It has
# no extension, so the type is set here; Apple fetches it through its own CDN.
/.well-known/apple-app-site-association
  Content-Type: application/json
